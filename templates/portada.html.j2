<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ sitio.marca.nombre }}</title>
<meta name="description" content="{{ sitio.marca.lema }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@700&family=Roboto+Condensed:wght@600;700&family=Roboto:wght@400;500;700&display=swap">
<link rel="stylesheet" href="portada.css">
<script>try { var tema = localStorage.getItem('mc-tema'); if (tema) document.documentElement.setAttribute('data-theme', tema); } catch (e) {}</script>
</head>
<body>
<header class="site">
  <div class="wrap top">
    <a class="logo" href="#" data-ir="portada" aria-label="{{ sitio.marca.nombre }}, portada"><span class="chip" aria-hidden="true"></span><span><b>{{ sitio.marca.nombre }}</b><small>{{ sitio.marca.lema }}</small></span></a>
    <span class="spacer"></span>
    <button class="iconbtn" id="b-buscar" type="button" aria-label="Buscar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
    <button class="iconbtn" id="b-tema" type="button" aria-label="Cambiar entre tema claro y oscuro"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
  </div>
  <div class="wrap buscar" id="caja-buscar"><input id="q" type="search" placeholder="Buscar jugador, torneo, sala…" aria-label="Buscar noticias"></div>
  <div class="wrap"><nav class="secciones" id="nav" aria-label="Secciones">
    <button type="button" data-k="portada">Portada</button>
    {% for s in sitio.secciones if s.menu and s.visible is not sameas false %}<button type="button" data-k="{{ s.id }}">{{ s.nombre }}</button>{% endfor %}
    {% for b in sitio.botones if b.visible is not sameas false %}<a href="{{ b.enlace }}">{{ b.texto }}</a>{% endfor %}
  </nav></div>
</header>
<div class="franja" id="franja-caja"><div class="wrap" id="franja"><span class="rot">Temas calientes</span></div></div>

<main><div class="wrap" id="out"><noscript>
  {% for t in tarjetas[:40] %}<p><a href="n/{{ t.id }}.html">{{ t.titulo }}</a></p>{% endfor %}
</noscript></div></main>

<footer class="site"><div class="wrap">
  <span>Actualizado el {{ hoy_texto }}</span>
  {% for a in aviso_sei %}<span><b>Aviso:</b> {{ a }}</span>{% endfor %}
  <span>{{ salud.activas }} de {{ salud.total }} fuentes activas</span>
  {% for b in sitio.botones if b.visible is not sameas false %}<a href="{{ b.enlace }}">{{ b.texto }}</a>{% endfor %}
</div></footer>

<script id="datos" type="application/json">{{ {"tarjetas": tarjetas, "secciones": sitio.secciones} | tojson }}</script>
<script>
(function () {
  const D = JSON.parse(document.getElementById('datos').textContent);
  const T = D.tarjetas, SEC = D.secciones.filter(s => s.visible !== false);
  const PALO = ['♠', '♥', '♦', '♣'];
  const MESES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const fechaLarga = iso => { const [y, m, d] = iso.split('-').map(Number); return `${d} de ${MESES[m - 1]} de ${y}`; };
  const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const norm = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const st = { sec: 'portada', q: '', vistos: 12 };

  const nav = document.getElementById('nav');
  const pintarMenu = () => nav.querySelectorAll('button[data-k]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.k === st.sec)));
  const ir = k => { st.sec = SEC.some(s => s.id === k) ? k : 'portada'; st.vistos = 12; pintarMenu(); render();
    try { history.replaceState(null, '', st.sec === 'portada' ? location.pathname : '#' + st.sec); } catch (e) {} };
  nav.addEventListener('click', e => { const b = e.target.closest('button[data-k]'); if (!b) return; ir(b.dataset.k); scrollTo({ top: 0 }); });
  document.querySelector('[data-ir="portada"]').addEventListener('click', e => { e.preventDefault(); ir('portada'); });

  const franja = document.getElementById('franja');
  const vistos = new Set(), temas = T.filter(x => x.sec === 'tema' && !vistos.has(x.titulo) && vistos.add(x.titulo)).slice(0, 12);
  if (!temas.length) document.getElementById('franja-caja').hidden = true;
  franja.insertAdjacentHTML('beforeend', temas.map(t => `<a href="n/${esc(t.id)}.html" style="flex:none;padding:9px 14px;white-space:nowrap;border-right:1px solid rgb(255 255 255 / .12)">${esc(t.titulo)}</a>`).join(''));

  document.getElementById('b-buscar').onclick = () => { const c = document.getElementById('caja-buscar'); c.classList.toggle('abierto'); if (c.classList.contains('abierto')) document.getElementById('q').focus(); };
  document.getElementById('q').addEventListener('input', e => { st.q = norm(e.target.value); st.vistos = 12; render(); });
  const root = document.documentElement;
  const oscuro = () => (root.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
  document.getElementById('b-tema').onclick = () => { const nuevo = oscuro() ? 'light' : 'dark'; root.setAttribute('data-theme', nuevo); try { localStorage.setItem('mc-tema', nuevo); } catch (e) {} };

  const palo = id => PALO[[...id].reduce((a, c) => a + c.charCodeAt(0), 0) % 4];
  const foto = x => `<div class="foto" data-palo="${palo(x.id)}">${x.foto ? `<img src="${esc(x.foto)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">${x.credito ? `<small>Foto: ${esc(x.credito)}</small>` : ''}` : ''}</div>`;
  const secHtml = x => `<span>${esc(x.cat)}</span>${x.sec === 'latam' ? '<span class="latam">Latam</span>' : ''}${x.region === 'europa' ? '<span class="latam">Europa</span>' : ''}`;
  const href = x => `href="n/${esc(x.id)}.html"`;
  const fuente = x => x.fuente ? `<span class="fuente">${esc(x.fuente)}${x.nf > 1 ? ` y ${x.nf - 1} más` : ''}</span>` : '';
  const principal = x => `<article class="principal"><a ${href(x)} tabindex="-1" aria-hidden="true">${foto(x)}</a>
    <div class="sec">${secHtml(x)}</div><h1 class="tit"><a ${href(x)}>${esc(x.titulo)}</a></h1><p class="baj">${esc(x.bajada)}</p>
    <div class="fecha">${fechaLarga(x.dia)}${x.fuente ? ' · ' + esc(x.fuente) : ''}</div></article>`;
  const mini = x => `<article class="mini"><div><div class="sec">${secHtml(x)}</div><h3 class="tit"><a ${href(x)}>${esc(x.titulo)}</a></h3><div class="fecha">${fechaLarga(x.dia)}</div></div><a ${href(x)} tabindex="-1" aria-hidden="true">${foto(x)}</a></article>`;
  const tarjeta = x => `<article class="tarjeta${x.destacada ? ' destacada' : ''}"><div><div class="sec">${secHtml(x)}</div><h3 class="tit"><a ${href(x)}>${esc(x.titulo)}</a></h3>
    <p class="baj">${esc(x.bajada)}</p><div class="pie"><span class="fecha">${fechaLarga(x.dia)}</span>${fuente(x)}</div></div><a ${href(x)} tabindex="-1" aria-hidden="true">${foto(x)}</a></article>`;
  const orden = (a, b) => (b.destacada ? 1 : 0) - (a.destacada ? 1 : 0) || b.dia.localeCompare(a.dia);
  const bloque = (titulo, lista, mas) => `<section class="bloque"><h2>${esc(titulo)}</h2><div class="rejilla">${lista.map(tarjeta).join('')}</div></section>` +
    (mas ? '<div class="mas"><button type="button" id="mas">Mostrar más</button></div>' : '');

  function render() {
    const out = document.getElementById('out');
    let r = T.slice();
    if (st.sec !== 'portada') r = r.filter(x => x.secs.includes(st.sec));
    if (st.q) r = r.filter(x => norm(`${x.titulo} ${x.bajada} ${x.fuente} ${x.cat}`).includes(st.q));
    r.sort(orden);
    if (!r.length) { out.innerHTML = '<div class="vacio">' + (st.q ? 'No hay noticias para esta búsqueda. Pruebe con otra palabra o vuelva a la portada.' : 'Todavía no hay noticias en esta sección.') + '</div>'; return; }
    let html = '';
    if (st.sec === 'portada' && !st.q) {
      const conFoto = r.filter(x => x.sec !== 'tema');
      const p = conFoto.find(x => x.destacada) || conFoto.find(x => x.foto) || conFoto[0] || r[0];
      const resto = r.filter(x => x !== p);
      const ultimo = resto.slice(0, 4), usados = new Set([p.id, ...ultimo.map(x => x.id)]);
      html += `<section class="portada">${principal(p)}<div class="lateral"><h2>Lo último</h2>${ultimo.map(mini).join('')}</div></section>`;
      SEC.filter(s => s.portada).forEach(s => { const lista = resto.filter(x => x.secs.includes(s.id) && !usados.has(x.id)).slice(0, s.cantidad || 6);
        lista.forEach(x => usados.add(x.id)); if (lista.length) html += bloque(s.nombre, lista, false); });
      const otras = resto.filter(x => !usados.has(x.id));
      if (otras.length) html += bloque('Más noticias', otras.slice(0, st.vistos), otras.length > st.vistos);
    } else {
      const s = SEC.find(x => x.id === st.sec);
      html += bloque(st.q ? 'Resultados de la búsqueda' : (s ? s.nombre : 'Noticias'), r.slice(0, st.vistos), r.length > st.vistos);
    }
    out.innerHTML = html;
    const m = document.getElementById('mas'); if (m) m.onclick = () => { st.vistos += 12; render(); };
  }
  const inicial = (location.hash || '').slice(1);
  window.addEventListener('hashchange', () => ir((location.hash || '').slice(1)));
  ir(inicial);
})();
</script>
</body>
</html>
