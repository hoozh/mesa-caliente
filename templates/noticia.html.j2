<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t.titulo }} · Mesa Caliente</title>
<meta name="description" content="{{ (t.resumen or '')[:160] }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=PT+Serif:wght@400;700&family=Roboto+Condensed:wght@700&family=Roboto:wght@400;500;700&display=swap">
<link rel="stylesheet" href="../noticia.css">
<script>try { var tema = localStorage.getItem('mc-tema'); if (tema) document.documentElement.setAttribute('data-theme', tema); } catch (e) {}</script>
</head>
<body>
{% set secciones = {'general': 'Escena mundial', 'latam': 'Latinoamérica', 'tema': 'Tema caliente'} %}
{% set seccion = t.etiqueta or ('Europa' if t.region == 'europa' else secciones.get(t.seccion, 'Noticias')) %}
<header class="site">
  <div class="wrap top">
    <a class="logo" href="../index.html"><span class="chip" aria-hidden="true"></span><b>Mesa Caliente</b></a>
    <span class="spacer"></span>
    <button class="iconbtn" id="b-tema" type="button" aria-label="Cambiar entre tema claro y oscuro">◐</button>
  </div>
</header>

<main class="wrap nota">
  <p class="sec">{{ seccion }}{% if t.clasificacion and t.clasificacion != 'confirmado' %} · <span class="clas">{{ etiquetas.get(t.clasificacion, t.clasificacion) }}</span>{% endif %}</p>
  <h1>{{ t.titulo }}</h1>
  <p class="fecha">{{ fecha_larga_iso(t.dia) }}</p>

  {% set imagenes = t.imagenes or ([{'url': t.imagen, 'fuente': (t.fuentes[0].nombre if t.fuentes else ''), 'enlace': (t.fuentes[0].url if t.fuentes else '')}] if t.imagen else []) %}
  {% macro figura(im) %}
  <figure class="foto">
    <img src="{{ im.url }}" alt="{{ im.pie or '' }}" loading="lazy" referrerpolicy="no-referrer">
    {% if im.pie or im.fuente %}<figcaption>{% if im.pie %}{{ im.pie }}{% if im.fuente %} · {% endif %}{% endif %}{% if im.fuente %}Foto: {% if im.enlace %}<a href="{{ im.enlace }}" target="_blank" rel="noopener">{{ im.fuente }}</a>{% else %}{{ im.fuente }}{% endif %}{% endif %}</figcaption>{% endif %}
  </figure>
  {% endmacro %}
  {% if imagenes %}{{ figura(imagenes[0]) }}{% endif %}

  {% if t.novedad %}<p class="novedad"><b>Qué cambió:</b> {{ t.novedad }}</p>{% endif %}
  {% set parrafos = (t.cuerpo or t.resumen or '').split('\n') | select('ne', '') | map('trim') | select | list %}
  <div class="cuerpo">
    {% if t.cuerpo and t.resumen %}<p class="bajada">{{ t.resumen }}</p>{% endif %}
    {% for parrafo in parrafos %}<p>{{ parrafo }}</p>{% if imagenes[loop.index] is defined %}{{ figura(imagenes[loop.index]) }}{% endif %}{% endfor %}
    {% for im in imagenes[parrafos | length + 1:] %}{{ figura(im) }}{% endfor %}
  </div>

  {% if t.novedades %}
  <h2>Novedades</h2>
  <ul class="novedades">
    {% for n in t.novedades %}
    <li>{{ n.aporta }}{% if n.url %} <a href="{{ n.url }}" target="_blank" rel="noopener">{{ n.fuente }} ↗</a>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}

  {% if t.fuentes %}
  <h2>Fuentes</h2>
  <ul class="fuentes">
    {% for f in t.fuentes %}
    <li><a href="{{ f.url }}" target="_blank" rel="noopener">{{ f.nombre }} ↗</a>{% if f.fecha %}<span> · {{ fecha_larga_iso(f.fecha) }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
  <p class="volver"><a href="../index.html">← Volver a Mesa Caliente</a></p>
</main>
<script>
document.getElementById('b-tema').onclick = function () {
  var r = document.documentElement, actual = r.getAttribute('data-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  var nuevo = actual === 'dark' ? 'light' : 'dark'; r.setAttribute('data-theme', nuevo);
  try { localStorage.setItem('mc-tema', nuevo); } catch (e) {}
};
</script>
</body>
</html>
